---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import players from '../data/players.json';

// ⚽ ポジションバッジ用のカラー判定
function getPositionCategory(pos: string): string {
  if (!pos) return "";
  const p = pos.toUpperCase();
  if (["CF", "ST", "LWG", "RWG", "FW"].includes(p)) return "fw";
  if (["OMF", "CMF", "LMF", "RMF", "DMF", "RSH", "LSH", "MF"].includes(p)) return "mf";
  if (["CB", "RSB", "LSB", "DF"].includes(p)) return "df";
  if (["GK"].includes(p)) return "gk";
  return "";
}
---

<BaseLayout pageTitle="ウイコレ攻略wiki | 選手一覧データベース">
  <h2 style="font-size: 1.3rem; border-left: 5px solid #00bfa5; padding-left: 12px; margin: 0 0 20px 0; color: #111; font-weight: bold;">選手一覧</h2>
  
  {/* 🔍 3マルチAND検索 ＆ 18種高機能ソートコントロールパネル */}
  <div style="margin-bottom: 20px; background-color: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
    
    {/* 🔍 選手名キーワード検索フォーム */}
    <div style="margin-bottom: 15px; padding-bottom: 15px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <label for="search-name" style="font-size: 0.9rem; font-weight: bold; color: #334155; display: flex; align-items: center; gap: 4px;">
        🔍 選手名検索:
      </label>
      <input 
        id="search-name" 
        type="text" 
        placeholder="選手名を入力（部分一致）..." 
        style="padding: 8px 14px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; width: 100%; max-width: 300px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);"
      />
    </div>

    {/* 📋 絞り込み条件 3パターン設置エリア */}
    <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 15px;">
      {[1, 2, 3].map((num) => (
        <div class="filter-row" style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center; border-bottom: 1px dashed #e2e8f0; padding-bottom: 10px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 0.8rem; background-color: #475569; color: #fff; padding: 2px 6px; border-radius: 4px; font-weight: bold;">条件 {num}</span>
            <select class="filter-type" data-index={num} style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; cursor: pointer; font-weight: bold;">
              <option value="all">指定なし（すべて表示）</option>
              <option value="pos">ポジション</option>
              <option value="mainPos">適正ポジション</option>
              <option value="type">タイプ</option>
              <option value="cardType">シリーズ</option>
              <option value="country">国・所属</option>
              <option value="skill">所持スキル</option>
            </select>
          </div>

          <div class="filter-condition-container" data-index={num} style="display: flex; align-items: center; gap: 8px;">
            <span class="cond-default-msg" style="font-size: 0.85rem; color: #888;">項目を選択してください</span>
            
            <select class="cond-pos" style="display: none; padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; font-weight: bold;">
              <option value="fw">FW</option>
              <option value="mf">MF</option>
              <option value="df">DF</option>
              <option value="gk">GK</option>
            </select>

            <select class="cond-main-pos" style="display: none; padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; font-weight: bold;">
              <option value="cf">CF</option>
              <option value="st">ST</option>
              <option value="lwg">LWG</option>
              <option value="rwg">RWG</option>
              <option value="omf">OMF</option>
              <option value="cmf">CMF</option>
              <option value="lsh">LSH</option>
              <option value="rsh">RSH</option>
              <option value="dmf">DMF</option>
              <option value="cb">CB</option>
              <option value="lsb">LSB</option>
              <option value="rsb">RSB</option>
              <option value="gk">GK</option>
            </select>

            <select class="cond-type" style="display: none; padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; font-weight: bold;">
              <option value="テクニック">テクニック</option>
              <option value="パワー">パワー</option>
              <option value="スピード">スピード</option>
              <option value="スタミナ">スタミナ</option>
              <option value="バランス">バランス</option>
            </select>
            
            <select class="cond-cardtype" style="display: none; padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; font-weight: bold;">
              <option value="レギュラー">レギュラー</option>
              <option value="ナショナル">ナショナル</option>
              <option value="レジェンド">レジェンド</option>
              <option value="エターナル">エターナル</option>
            </select>
            
            <input class="cond-keyword" type="text" placeholder="キーワードを入力..." style="display: none; padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; width: 180px;" />
          </div>
        </div>
      ))}
    </div>

    {/* 🔢 並び替え＆表示件数セレクト */}
    <div style="display: flex; align-items: center; gap: 20px; justify-content: flex-start; padding-top: 5px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="font-size: 0.85rem; font-weight: bold; color: #475569;">並び替え:</label>
        <select id="sort-order" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; cursor: pointer; font-weight: bold;">
          <option value="grade-desc">グレードが高い順</option>
          <option value="grade-asc">グレードが低い順</option>
          <option value="total-desc">総合力が高い順</option>
          <option value="total-asc">総合力が低い順</option>
          <option value="ofe-desc">オフェンスが高い順</option>
          <option value="ofe-asc">オフェンスが低い順</option>
          <option value="tec-desc">テクニックが高い順</option>
          <option value="tec-asc">テクニックが低い順</option>
          <option value="sta-desc">スタミナが高い順</option>
          <option value="sta-asc">スタミナが低い順</option>
          <option value="def-desc">ディフェンスが高い順</option>
          <option value="def-asc">ディフェンスが低い順</option>
          <option value="pow-desc">パワーが高い順</option>
          <option value="pow-asc">パワーが低い順</option>
          <option value="spd-desc">スピードが高い順</option>
          <option value="spd-asc">スピードが低い順</option>
          <option value="birth-asc">生年月日が早い順 (年長)</option>
          <option value="birth-desc">生年月日が遅い順 (若手)</option>
        </select>
      </div>

      {/* 🆕 🔐 所持済みフラグによる絞り込みチェックボックス */}
      <div style="display: flex; align-items: center; gap: 6px;">
        <input 
          type="checkbox" 
          id="filter-owned" 
          style="width: 16px; height: 16px; cursor: pointer; margin: 0;"
        />
        <label for="filter-owned" style="font-size: 0.85rem; font-weight: bold; color: #475569; cursor: pointer; user-select: none;">
          📦 所持済みのみ表示
        </label>
      </div>

      {/* 🆕 表示件数切替 */}
      <div style="display: flex; align-items: center; gap: 8px; margin-left: auto;">
        <label style="font-size: 0.85rem; font-weight: bold; color: #475569;">表示件数:</label>
        <select id="items-per-page" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem; background-color: #fff; cursor: pointer; font-weight: bold;">
          <option value="10">10件</option>
          <option value="20" selected>20件</option>
          <option value="50">50件</option>
        </select>
      </div>
    </div>
  </div>

  {/* 🆕 🔢 ページネーションコントロール（上部） */}
  <div id="pagination-container-top" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 15px; flex-wrap: wrap;"></div>
  
    {/* 📋 選手リストコンテナ */}
  <div id="player-list-wrapper" style="border: 1px solid #e1e4e6; border-radius: 8px; overflow: hidden; background-color: #ffffff;">
    {players.map((player) => {
      let rowStyle = "display: flex; align-items: center; padding: 14px 20px; flex-wrap: wrap; gap: 15px; transition: opacity 0.2s; border-bottom: 1px solid #e1e4e6;";
      
      const currentPos = player.position ? player.position.toUpperCase() : "";
      let pColor = "";
      if (["CF", "ST", "LWG", "RWG", "FW"].includes(currentPos)) pColor = "bg-fw";
      if (["OMF", "CMF", "DMF", "RSH", "LSH", "MF"].includes(currentPos)) pColor = "bg-mf";
      if (["CB", "RSB", "LSB", "DF"].includes(currentPos)) pColor = "bg-df";
      if (["GK"].includes(currentPos)) pColor = "bg-gk";

      if (pColor === "bg-fw") rowStyle += " background-color: #fff5f5; border-bottom-color: #fbc4c4;"; 
      if (pColor === "bg-mf") rowStyle += " background-color: #f4fbf7; border-bottom-color: #c2ecd7;"; 
      if (pColor === "bg-df") rowStyle += " background-color: #f4f9fd; border-bottom-color: #c9e3f6;"; 
      if (pColor === "bg-gk") rowStyle += " background-color: #fffdf2; border-bottom-color: #f9f0c2;"; 

      const mainPosCat = getPositionCategory(currentPos);
      const allSkills = [...(player.specialSkills || []), ...(player.selectSkills || [])].join(',');
      const mainPositionsStr = (player.positionsMain || []).join(',').toLowerCase();

      const k = (player.status && player.status.kira_lv80 ? player.status.kira_lv80 : {}) as { [key: string]: number };

      const ofe = Number(k.ofe) || 0;
      const tec = Number(k.tec) || 0;
      const sta = Number(k.sta) || 0;
      const def = Number(k.def) || 0;
      const pow = Number(k.pow) || 0;
      const spd = Number(k.spd) || 0;
      const total = ofe + tec + sta + def + pow + spd;
      const birth = player.birth || "";

      return (
        <a 
          href={`/players/${player.id}`} 
          class="player-list-item" 
          data-id={player.id}
          data-name={player.name}
          data-grade={player.grade} 
          data-pos={mainPosCat} 
          data-main-positions={mainPositionsStr}
          data-type={player.type} 
          data-skills={allSkills} 
          data-country={player.country} 
          data-cardtype={player.cardType}
          data-birth={birth}
          data-total={total}
          data-ofe={ofe} data-tec={tec} data-sta={sta} data-def={def} data-pow={pow} data-spd={spd}
          style="text-decoration: none; color: inherit; display: block;"
        >
          <div class="player-row-content" style={rowStyle}>
            {/* 🆕 🔐 各選手ごとの所持チェックボックス */}
            <div class="player-owned-checkbox-container" style="display: flex; align-items: center; justify-content: center;">
              <input 
                type="checkbox" 
                class="player-owned-cb" 
                style="width: 18px; height: 18px; cursor: pointer; margin: 0;"
              />
            </div>
            
            <span class="player-grade-badge">{player.grade}</span>
            <div class="player-pos-container">
              <span class={`badge-item ${mainPosCat}`}>{player.position}</span>
            </div>
            <h3 class="player-name-text">{player.name}</h3>
            <span class="player-series-text">({player.cardType})</span>
            <div class="player-skill-text">
              {[...(player.specialSkills || []), ...(player.selectSkills || [])].join(' / ')}
            </div>
          </div>
        </a>
      );
    })}
  </div>

  {/* 🔢 ページネーションコントロール（下部） */}
  <div id="pagination-container-bottom" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; flex-wrap: wrap;"></div>

  {/* 📭 絞り込み結果がゼロの時のセーフメッセージ */}
  <div id="no-players-msg" style="display: none; text-align: center; padding: 40px; border: 1px dashed #cbd5e1; border-radius: 8px; color: #64748b; background-color: #f8fafc; font-weight: bold; margin-top: 15px;">
    🔍 条件に一致する選手は見つかりませんでした。
  </div>
</BaseLayout>

<script>
  function initAdvancedSearch() {
    const sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
    const wrapper = document.getElementById('player-list-wrapper') as HTMLElement;
    const noMsg = document.getElementById('no-players-msg') as HTMLElement;
    const pagContainerTop = document.getElementById('pagination-container-top') as HTMLElement;
    const pagContainerBottom = document.getElementById('pagination-container-bottom') as HTMLElement;
    const searchName = document.getElementById('search-name') as HTMLInputElement;
    const filterOwned = document.getElementById('filter-owned') as HTMLInputElement; // 🆕 所持フィルター取得

    if (!sortOrder || !wrapper || !noMsg || !pagContainerTop || !pagContainerBottom || !searchName || !filterOwned) return;

    const initialItems = Array.from(wrapper.querySelectorAll('.player-list-item')) as HTMLElement[];
    const filterRows = Array.from(document.querySelectorAll('.filter-row'));

    // 📄 ページネーション状態管理
    let currentPage = 1;

    // 🆕 LocalStorageから初期の所持リストを読み込み、各行のチェック状態を同期
    function syncOwnedCheckboxes() {
      const stored = localStorage.getItem('wcc_owned_players');
      const ownedIds = stored ? JSON.parse(stored) : [];
      initialItems.forEach(item => {
        const pId = item.getAttribute('data-id');
        const cb = item.querySelector('.player-owned-cb') as HTMLInputElement;
        if (cb && pId) {
          cb.checked = ownedIds.includes(pId);
        }
      });
    }

    // 🆕 各選手のチェックボックスへのイベント設定（Aタグの遷移を防止し、状態を保存）
    initialItems.forEach(item => {
      const cb = item.querySelector('.player-owned-cb') as HTMLInputElement;
      if (!cb) return;

      // リンク遷移（バブリング）を止める
      cb.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // チェック変更時にLocalStorageへ保存してリストを再更新
      cb.addEventListener('change', () => {
        const pId = item.getAttribute('data-id');
        if (!pId) return;

        const stored = localStorage.getItem('wcc_owned_players');
        let ownedIds = stored ? JSON.parse(stored) : [];

        if (cb.checked) {
          if (!ownedIds.includes(pId)) ownedIds.push(pId);
        } else {
          ownedIds = ownedIds.filter((id: string) => id !== pId);
        }
        localStorage.setItem('wcc_owned_players', JSON.stringify(ownedIds));

        // 「所持済みのみ表示」がONの場合は、リスト変動を反映させるため再描画
        if (filterOwned.checked) {
          updateList();
        }
      });
    });

    // 初期化時にチェックボックスの状態を復元
    syncOwnedCheckboxes();

    // 表示件数変更時のイベントを設定
    const itemsPerPageSelect = document.getElementById('items-per-page') as HTMLSelectElement;
    if (itemsPerPageSelect) {
      itemsPerPageSelect.addEventListener('change', () => {
        currentPage = 1;
        updateList();
      });
    }

    // 🆕 所持済みのみ表示フィルターのイベント設定
    filterOwned.addEventListener('change', () => {
      currentPage = 1;
      updateList();
    });

    // 各条件行のUI表示切り替えを設定
    filterRows.forEach(row => {
      const filterType = row.querySelector('.filter-type') as HTMLSelectElement;
      const msgDefault = row.querySelector('.cond-default-msg') as HTMLElement;
      const selectPos = row.querySelector('.cond-pos') as HTMLSelectElement;
      const selectMainPos = row.querySelector('.cond-main-pos') as HTMLSelectElement;
      const selectType = row.querySelector('.cond-type') as HTMLSelectElement;
      const selectCardType = row.querySelector('.cond-cardtype') as HTMLSelectElement;
      const inputKeyword = row.querySelector('.cond-keyword') as HTMLInputElement;

      if (!filterType) return;

      function handleRowTypeChange() {
        const type = filterType.value;
        if (msgDefault) msgDefault.style.display = 'none';
        if (selectPos) selectPos.style.display = 'none';
        if (selectMainPos) selectMainPos.style.display = 'none';
        if (selectType) selectType.style.display = 'none';
        if (selectCardType) selectCardType.style.display = 'none';
        if (inputKeyword) inputKeyword.style.display = 'none';

        if (type === 'all' && msgDefault) msgDefault.style.display = 'inline-block';
        if (type === 'pos' && selectPos) selectPos.style.display = 'inline-block';
        if (type === 'mainPos' && selectMainPos) selectMainPos.style.display = 'inline-block';
        if (type === 'type' && selectType) selectType.style.display = 'inline-block';
        if (type === 'cardType' && selectCardType) selectCardType.style.display = 'inline-block';
        if ((type === 'skill' || type === 'country') && inputKeyword) {
          inputKeyword.style.display = 'inline-block';
          inputKeyword.placeholder = type === 'skill' ? 'スキル名を入力...' : '国名・所属を入力...';
        }
        if (inputKeyword) inputKeyword.value = '';

        currentPage = 1;
        updateList();
      }

      filterType.addEventListener('change', handleRowTypeChange);
      if (selectPos) selectPos.addEventListener('change', () => { currentPage = 1; updateList(); });
      if (selectMainPos) selectMainPos.addEventListener('change', () => { currentPage = 1; updateList(); });
      if (selectType) selectType.addEventListener('change', () => { currentPage = 1; updateList(); });
      if (selectCardType) selectCardType.addEventListener('change', () => { currentPage = 1; updateList(); });
      if (inputKeyword) inputKeyword.addEventListener('input', () => { currentPage = 1; updateList(); });
    });

    // 選手名入力時のリアルタイムイベントを設定
    searchName.addEventListener('input', () => {
      currentPage = 1;
      updateList();
    });

    // 🔢 ページネーションUIの動的生成（上下対応版）
    function renderPagination(totalVisibleCount: number) {
      pagContainerTop.innerHTML = '';
      pagContainerBottom.innerHTML = '';
      
      const itemsPerPage = parseInt(itemsPerPageSelect?.value || '20', 10);
      const totalPages = Math.ceil(totalVisibleCount / itemsPerPage);
      if (totalPages <= 1) return;

      [pagContainerTop, pagContainerBottom].forEach(container => {
        const prevBtn = document.createElement('button');
        prevBtn.className = 'page-btn';
        prevBtn.innerText = '◀';
        prevBtn.disabled = currentPage === 1;
        prevBtn.addEventListener('click', () => {
          currentPage--;
          updateList();
          window.scrollTo({top: 0, behavior: 'smooth'});
        });
        container.appendChild(prevBtn);

        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
          pageBtn.innerText = i.toString();
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            updateList();
            window.scrollTo({top: 0, behavior: 'smooth'});
          });
          container.appendChild(pageBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.className = 'page-btn';
        nextBtn.innerText = '▶';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.addEventListener('click', () => {
          currentPage++;
          updateList();
          window.scrollTo({top: 0, behavior: 'smooth'});
        });
        container.appendChild(nextBtn);
      });
    }

        function updateList() {
      const sort = sortOrder.value;
      const nameQuery = searchName.value.toLowerCase().trim();
      const itemsPerPage = parseInt(itemsPerPageSelect?.value || '20', 10);
      
      // 🆕 フィルタ条件の取得
      const showOwnedOnly = filterOwned.checked;
      const stored = localStorage.getItem('wcc_owned_players');
      const ownedIds = stored ? JSON.parse(stored) : [];

      const activeFilters = filterRows.map(row => {
        const type = (row.querySelector('.filter-type') as HTMLSelectElement).value;
        return {
          type,
          pos: (row.querySelector('.cond-pos') as HTMLSelectElement).value,
          mainPos: (row.querySelector('.cond-main-pos') as HTMLSelectElement).value,
          playerType: (row.querySelector('.cond-type') as HTMLSelectElement).value,
          cardType: (row.querySelector('.cond-cardtype') as HTMLSelectElement).value,
          keyword: (row.querySelector('.cond-keyword') as HTMLInputElement).value.toLowerCase().trim()
        };
      });

      const matchedItems = initialItems.filter(item => {
        const playerId = item.getAttribute('data-id') || '';

        // 🆕 所持フラグによるフィルタリング判定
        if (showOwnedOnly && !ownedIds.includes(playerId)) {
          return false;
        }

        if (nameQuery) {
          const playerName = (item.getAttribute('data-name') || '').toLowerCase();
          if (!playerName.includes(nameQuery)) return false;
        }

        return activeFilters.every(filter => {
          if (filter.type === 'all') return true;
          if (filter.type === 'pos') return item.getAttribute('data-pos') === filter.pos;
          if (filter.type === 'mainPos') return (item.getAttribute('data-main-positions') || "").split(',').includes(filter.mainPos);
          if (filter.type === 'type') return item.getAttribute('data-type') === filter.playerType;
          if (filter.type === 'cardType') return (item.getAttribute('data-cardtype') || "").includes(filter.cardType);
          if (filter.type === 'skill') return (item.getAttribute('data-skills') || "").toLowerCase().includes(filter.keyword);
          if (filter.type === 'country') return (item.getAttribute('data-country') || "").toLowerCase().includes(filter.keyword);
          return true;
        });
      });

      const totalVisibleCount = matchedItems.length;

      matchedItems.sort((a, b) => {
        const gradeA = parseInt(a.getAttribute('data-grade') || '0', 10);
        const gradeB = parseInt(b.getAttribute('data-grade') || '0', 10);
        const totalA = parseInt(a.getAttribute('data-total') || '0', 10);
        const totalB = parseInt(b.getAttribute('data-total') || '0', 10);
        const ofeA = parseInt(a.getAttribute('data-ofe') || '0', 10);
        const ofeB = parseInt(b.getAttribute('data-ofe') || '0', 10);
        const tecA = parseInt(a.getAttribute('data-tec') || '0', 10);
        const tecB = parseInt(b.getAttribute('data-tec') || '0', 10);
        const staA = parseInt(a.getAttribute('data-sta') || '0', 10);
        const staB = parseInt(b.getAttribute('data-sta') || '0', 10);
        const defA = parseInt(a.getAttribute('data-def') || '0', 10);
        const defB = parseInt(b.getAttribute('data-def') || '0', 10);
        const powA = parseInt(a.getAttribute('data-pow') || '0', 10);
        const powB = parseInt(b.getAttribute('data-pow') || '0', 10);
        const spdA = parseInt(a.getAttribute('data-spd') || '0', 10);
        const spdB = parseInt(b.getAttribute('data-spd') || '0', 10);
        const birthA = a.getAttribute('data-birth') || '9999-12-31';
        const birthB = b.getAttribute('data-birth') || '9999-12-31';

        switch (sort) {
          case 'grade-desc': return gradeB - gradeA;
          case 'grade-asc':  return gradeA - gradeB;
          case 'total-desc': return totalB - totalA;
          case 'total-asc':  return totalA - totalB;
          case 'ofe-desc':   return ofeB - ofeA;
          case 'ofe-asc':    return ofeA - ofeB;
          case 'tec-desc':   return tecB - tecA;
          case 'tec-asc':    return tecA - tecB;
          case 'sta-desc':   return staB - staA;
          case 'sta-asc':    return staA - staB;
          case 'def-desc':   return defB - defA;
          case 'def-asc':    return defA - defB;
          case 'pow-desc':   return powB - powA;
          case 'pow-asc':    return powA - powB;
          case 'spd-desc':   return spdB - spdA;
          case 'spd-asc':    return spdA - spdB;
          case 'birth-asc':  return birthA.localeCompare(birthB);
          case 'birth-desc': return birthB.localeCompare(birthA);
          default:           return gradeB - gradeA;
        }
      });

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      initialItems.forEach(item => {
        const matchIndex = matchedItems.indexOf(item);
        if (matchIndex >= startIndex && matchIndex < endIndex) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });

      matchedItems.forEach(item => wrapper.appendChild(item));

      noMsg.style.display = totalVisibleCount === 0 ? 'block' : 'none';
      wrapper.style.display = totalVisibleCount === 0 ? 'none' : 'block';

      renderPagination(totalVisibleCount);
    }

    sortOrder.addEventListener('change', updateList);
    updateList();

    const navHome = document.getElementById('nav-home');
    if (navHome) navHome.classList.add('active');
  }

  initAdvancedSearch();
  document.addEventListener('astro:after-swap', initAdvancedSearch);
</script>

