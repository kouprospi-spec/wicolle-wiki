---
// src/pages/schedule.astro (冒頭フロントマター・日本時間時差バグ完全修正版)
import BaseLayout from '../layouts/BaseLayout.astro';
import scheduleList from '../data/schedule.json';

// 📅 現在時刻から日本時間（JST）の年月日を正確にピンポイント取得
const nowJST = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Tokyo" }));
const todayY = nowJST.getFullYear();
const todayM = nowJST.getMonth();
const todayD = nowJST.getDate();

// 時分秒を完全に排除し、純粋なJSTの「今日（10/31）」のオブジェクトを生成
const today = new Date(todayY, todayM, todayD, 0, 0, 0, 0);

// 今週の日曜日（カレンダーの初め）を今日から逆算して正確に固定
const dayOfWeek = today.getDay();
const thisSunday = new Date(today);
thisSunday.setDate(today.getDate() - dayOfWeek);

// 📐 安全に日付オブジェクトを生成する関数（時差・空欄バグ回避）
function parseLocalDate(dateStr) {
  if (!dateStr || dateStr.trim() === "") return null;
  const parts = dateStr.split('-');
  if (parts.length !== 3) return null;
  // 時差の影響を受けないよう、ローカルのタイムゾーンで日付を固定生成
  return new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]), 0, 0, 0, 0);
}

// ⏳ 終了日までの残り日数を計算してアテンション用の文字を返す関数
function getAttentionText(endDateStr, currentDayObj) {
  if (!endDateStr) return null;
  
  const endDay = parseLocalDate(endDateStr);
  if (!endDay) return null;

  const diffTime = endDay.getTime() - currentDayObj.getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return "本日終了";
  if (diffDays > 0 && diffDays <= 3) return `あと ${diffDays} 日`;
  
  return null;
}

// 📐 4週間分の週タブと、その中の7日間（日〜土）のデータを生成
const weeks = Array.from({ length: 4 }, (_, weekIdx) => {
  const weekStart = new Date(thisSunday);
  weekStart.setDate(thisSunday.getDate() + (weekIdx * 7));
  
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekStart.getDate() + 6);
  
  const startStr = `${weekStart.getMonth() + 1}/${weekStart.getDate()}`;
  const endStr = `${weekEnd.getMonth() + 1}/${weekEnd.getDate()}`;
  const rangeStr = `${startStr}～${endStr}`;
  
  const daysInWeek = Array.from({ length: 7 }, (__, dayIdx) => {
    const currentDay = new Date(weekStart);
    currentDay.setDate(weekStart.getDate() + dayIdx);
    currentDay.setHours(0, 0, 0, 0);
    
    const month = currentDay.getMonth() + 1;
    const date = currentDay.getDate();
    const dayName = ["日", "月", "火", "水", "木", "金", "土"][currentDay.getDay()];
    
    // 🔍 この1日に期間が重なっているデータをJSONから自動抽出
    const dayItems = scheduleList.filter(item => {
      const itemStart = parseLocalDate(item.startDate);
      if (!itemStart) return false;
      
      const itemEnd = item.endDate ? parseLocalDate(item.endDate) : new Date(2099, 11, 31);
      
      return currentDay.getTime() >= itemStart.getTime() && currentDay.getTime() <= itemEnd.getTime();
    }).map(item => {
      return {
        ...item,
        attention: getAttentionText(item.endDate, currentDay)
      };
    });

    return {
      dateLabel: `${month}/${date}(${dayName})`,
      isToday: currentDay.getTime() === today.getTime(),
      dayOfWeek: currentDay.getDay(),
      items: dayItems
    };
  });

  return {
    index: weekIdx,
    tabLabel: weekIdx === 0 ? `今週 (${rangeStr})` : rangeStr,
    dateRange: `${startStr} ～ ${endStr}`,
    days: daysInWeek
  };
});
---

<BaseLayout pageTitle="ウイコレ攻略wiki | 日別イベントスケジュール">
  <h2 style="font-size: 1.3rem; border-left: 5px solid #00bfa5; padding-left: 12px; margin: 0 0 20px 0; color: #111;">今後のイベント・ガチャスケジュール</h2>
  <p style="font-size: 0.9rem; color: #666; margin-bottom: 25px;">イベント・ガチャ・交換所ごとに開始日と終了日を指定することで、該当する日のスケジュールに自動で表示されます。</p>

  {/* 🔘 週切り替えタブナビゲーション [1.2] */}
  <div class="schedule-tab-container" style="display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px;">
    {weeks.map((week) => (
      <button 
        class={`schedule-tab-btn ${week.index === 0 ? 'active' : ''}`} 
        data-week-index={week.index}
        style="white-space: nowrap;"
      >
        {week.tabLabel}
      </button>
    ))}
  </div>

  {/* 📋 各週のスケジュール（日別タイムライン）エリア [1.2] */}
  <div class="schedule-content-container">
    {weeks.map((week) => (
      <div 
        class="schedule-week-panel" 
        id={`week-panel-${week.index}`}
        style={week.index === 0 ? "display: block;" : "display: none;"}
      >
        <div class="daily-schedule-container" style="display: flex; flex-direction: column; gap: 12px;">
          {week.days.map((day) => {
            let dateBoxStyle = "width: 110px; padding: 12px; text-align: center; font-weight: bold; font-size: 0.95rem; border-right: 1px solid #e1e4e6; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;";
            if (day.isToday) {
              dateBoxStyle += " background-color: #00bfa5; color: #ffffff;";
            } else if (day.dayOfWeek === 6) {
              dateBoxStyle += " background-color: #eef6ff; color: #2b6cb0;";
            } else if (day.dayOfWeek === 0) {
              dateBoxStyle += " background-color: #fff5f5; color: #c53030;";
            } else {
              dateBoxStyle += " background-color: #f7f9fa; color: #333333;";
            }

            return (
              <div class="daily-row" style="display: flex; border: 1px solid #e1e4e6; border-radius: 6px; background-color: #ffffff; overflow: hidden; min-height: 55px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                {/* 左側：日付ラベル枠 [1.2] */}
                <div style={dateBoxStyle}>
                  {day.isToday && <span style="font-size: 0.65rem; display: block; margin-bottom: 2px; font-weight: normal; letter-spacing: 1px; color: #fff;">TODAY</span>}
                  {day.dateLabel}
                </div>

                {/* 右側：その日のイベント・ガチャ・キャンペーン・交換所一覧 [1.2] */}
                <div style="padding: 12px 18px; display: flex; flex-direction: column; gap: 8px; justify-content: center; flex: 1;">
                  {day.items.length > 0 ? (
                    day.items.map((item) => (
                      <div style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; flex-wrap: wrap;">
                        {/* JSON内の badgeText と type に連動したカラーバッジ [1.2] */}
                        <span class={`type-badge ${item.type}`} style="font-size: 0.75rem; font-weight: bold; padding: 2px 6px; border-radius: 4px; min-width: 80px; text-align: center; color: #ffffff; display: inline-block;">
                          {item.badgeText || "お知らせ"}
                        </span>
                        
                        {/* ガチャ(gacha)の場合はタイトルを青文字リンクにしてガチャページへ直接ジャンプ可能 [1.2] */}
                        {item.type === 'gacha' ? (
                          <a href="/gacha-info" class="gacha-schedule-link" style="font-weight: bold; color: #0073e6; text-decoration: none; line-height: 1.4;">
                            {item.title} <span style="font-size: 0.75rem; font-weight: normal; color: #999;">＞</span>
                          </a>
                        ) : (
                          <span style="font-weight: bold; color: #222222; line-height: 1.4;">{item.title}</span>
                        )}

                        {/* 💡 残り3日以内になったイベントの横にGameWith風の赤いアテンション警告バッジを自動点点灯 [1.2] */}
                        {item.attention && (
                          <span class="attention-badge" style="background-color: #ea2027; color: #ffffff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 4px; margin-left: 5px; animation: pulseEffect 2s infinite;">
                            {item.attention}
                          </span>
                        )}
                      </div>
                    ))
                  ) : (
                    <span style="color: #94a3b8; font-size: 0.85rem; font-style: italic;">予定なし</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

{/* 🧠 タブ制御スクリプト [1.2] */}
<script>
  function initScheduleTabs() {
    const buttons = document.querySelectorAll('.schedule-tab-btn');
    const panels = document.querySelectorAll('.schedule-week-panel');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const targetIndex = button.getAttribute('data-week-index');

        buttons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        panels.forEach(panel => {
          const element = panel as HTMLElement;
          if (element.id === `week-panel-${targetIndex}`) {
            element.style.display = 'block';
          } else {
            element.style.display = 'none';
          }
        });
      });
    });
  }

  initScheduleTabs();
  document.addEventListener('astro:after-swap', initScheduleTabs);
</script>

<style is:global>
  /* 左メニューの「スケジュール」アクティブ化 [1.2] */
  #nav-schedule { font-weight: bold; }

  /* 🏷️ badgeText（type）に対応するバッジカラー定義 */
  .type-badge.gacha { background-color: #e74c3c; }       /* ガチャ：赤 */
  .type-badge.event { background-color: #3498db; }       /* イベント：青 */
  .type-badge.campaign { background-color: #2ecc71; }    /* キャンペーン：緑 */
  .type-badge.exchange { background-color: #e84393; }    /* 💡新設：交換所（マゼンタピンク） */

  /* 🔗 ガチャスケジュールリンクのホバー演出 [1.2] */
  .gacha-schedule-link:hover {
    color: #0056b3 !important;
    text-decoration: underline !important;
  }

  /* 🔘 タブボタン装飾 [1.2] */
  .schedule-tab-btn {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: bold;
    cursor: pointer;
    color: #475569;
    transition: all 0.2s;
  }
  .schedule-tab-btn:hover {
    background-color: #f1f5f9;
  }
  .schedule-tab-btn.active {
    background-color: #00bfa5;
    border-color: #00bfa5;
    color: #ffffff;
  }

  /* 行ホバー時のハイライト効果 [1.2] */
  .daily-row { transition: border-color 0.15s, box-shadow 0.15s; }
  .daily-row:hover {
    border-color: #00bfa5 !important;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05) !important;
  }

  /* 💡 アテンションバッジ用のふんわり点滅エフェクト [1.2] */
  @keyframes pulseEffect {
    0% { opacity: 1; }
    50% { opacity: 0.75; }
    100% { opacity: 1; }
  }
</style>